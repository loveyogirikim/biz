# .env.example — 이 파일을 복사해 `.env` 로 만든 뒤 값을 채우세요.
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# 실제 배포: Vercel 대시보드 → Settings → Environment Variables 에 같은 이름으로 등록

# ── 사업계획서 도우미 (Vercel) ───────────────────────────────
# Claude API 키 — https://console.anthropic.com 에서 발급. 서버에만 저장되고 브라우저에 노출되지 않습니다.
ANTHROPIC_API_KEY=

# (선택) 모델. 비워두면 claude-opus-5 (사업계획서 품질 기준 권장)
# CLAUDE_MODEL=claude-opus-5
# (선택) 추론 깊이 low | medium | high(기본) — 낮추면 빠르고 저렴하지만 품질이 떨어질 수 있습니다
# CLAUDE_EFFORT=high

# (선택) 이용 코드 — 설정하면 코드를 아는 사람만 AI 기능을 쓸 수 있습니다 (API 비용 보호)
# ACCESS_CODE=우리가게2026

# (선택) 이 API를 부를 수 있는 외부 사이트 (예: 기존 sosang-helper 화면에서 호출할 때)
# ALLOWED_ORIGINS=https://sosang-helper.vercel.app

# (선택) IP당 시간당 AI 호출 한도 (기본 60, 0이면 제한 없음)
# RATE_LIMIT_PER_HOUR=60

# (선택) 키 없이 화면 흐름만 시험하는 데모 모드 — 실제 서비스에서는 켜지 마세요
# LLM_MODE=fake

# ── 기업마당 → Notion 수집기 (main.py) / 공고 목록 (scripts/export_announcements.py) ──
BIZINFO_API_KEY=
NOTION_TOKEN=
NOTION_DB_ID=
